# Frontend (embedded at build time — set on Render before deploy)
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Backend
PORT=3001
JWT_SECRET=change-this-in-production
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
ADMIN_EMAILS=your-admin@gmail.com

# Google OAuth setup:
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized JavaScript origins:
#    - http://localhost:5173
#    - https://linden-sports-bar.onrender.com
#    - https://linden-sports-bar.vercel.app
# 4. Use the same Client ID for VITE_GOOGLE_CLIENT_ID and GOOGLE_CLIENT_ID

# Apple Sign In setup:
# 1. https://developer.apple.com → Certificates, Identifiers & Profiles
# 2. Create a Services ID (e.g. com.lindensportsbar.web)
# 3. Enable Sign in with Apple → configure domain & return URLs:
#    - Domains: linden-sports-bar.onrender.com, localhost
#    - Return URLs: https://linden-sports-bar.onrender.com, http://localhost:5173
# 4. Use the Services ID for VITE_APPLE_CLIENT_ID and APPLE_CLIENT_ID
