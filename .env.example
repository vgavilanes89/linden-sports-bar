# Local dev only (optional — production reads from server env via /api/config/public)
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Backend / Render (set these in Render → Environment)
PORT=3001
JWT_SECRET=change-this-in-production
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
ADMIN_EMAILS=your-admin@gmail.com

# SMS verification (Twilio) — optional in dev (codes logged to server console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google OAuth setup:
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized JavaScript origins:
#    - http://localhost:5173
#    - https://linden-sports-bar.onrender.com
# 4. Set GOOGLE_CLIENT_ID in Render to your Client ID (no secret needed)

# Apple Sign In setup:
# 1. https://developer.apple.com → Certificates, Identifiers & Profiles
# 2. Create a Services ID (e.g. com.lindensportsbar.web)
# 3. Enable Sign in with Apple → configure domain & return URLs:
#    - Domains: linden-sports-bar.onrender.com, localhost
#    - Return URLs: https://linden-sports-bar.onrender.com, http://localhost:5173
# 4. Set APPLE_CLIENT_ID in Render to your Services ID
